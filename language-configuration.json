{
  "comments": { "lineComment": ";" },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["'", "'"], ["\"", "\""]],
  "wordPattern": "[A-Za-z_!][A-Za-z0-9_!.$]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\S*\\s*\\.(DEFM|IFDEF|IFNDEF|IFEQ|IFNE|IFGT|IFGE|IFLT|IFLE|REPT)\\b",
    "decreaseIndentPattern": "^\\s*\\.(ENDM|ENDIF|ENDR|ELSE)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*[*;]\\s*#?region\\b",
      "end": "^\\s*[*;]\\s*#?endregion\\b"
    }
  }
}
