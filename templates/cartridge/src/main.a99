*----------------------------------------------------------------------
* MY CARTRIDGE
*
* Build:  TI-99: Build            Run:  TI-99: Build and Run
* Output: dist/my-cartridge.rpk   (MAME)
*         dist/MYCARTC.BIN        (Classic99, -rom)
*----------------------------------------------------------------------
       DEF  STDHDR

VDPWD  EQU  >8C00                * VDP write data
VDPWA  EQU  >8C02                * VDP set address
WRKSP  EQU  >8300                * Scratchpad workspace, no wait states

* Cartridge ROM lives at >6000->7FFF
       AORG >6000

STDHDR BYTE >AA                  * Standard header marker
       BYTE >01                  * Version
       BYTE >01                  * One program
       BYTE >00                  * Reserved
       DATA >0000                * Power-up list
       DATA PROG                 * Program list
       DATA >0000                * DSR list
       DATA >0000                * Subprogram list
       DATA >0000                * ISR list

PROG   DATA >0000                * No next item
       DATA MAIN                 * Entry point
       BYTE 10                   * Menu text length
       TEXT 'MY PROGRAM'
       EVEN

*----------------------------------------------------------------------
* Entry point
*----------------------------------------------------------------------
MAIN   LIMI 0                    * Interrupts off during setup
       LWPI WRKSP                * Our own workspace

       CLR  R0
       MOVB R0,@>837A            * No sprites in automatic motion

* Set the VDP registers from the table
       LI   R1,REGLD
       LI   R2,>8000             * Register 0, write bit set
REGLP  MOVB *R1+,R3
       MOVB R3,@VDPWA            * Value first
       MOVB R2,@VDPWA            * Then register number
       AI   R2,>0100
       CI   R2,>8800
       JL   REGLP

* Clear the screen to spaces
       LI   R0,>4000             * VDP >0000 for writing
       SWPB R0
       MOVB R0,@VDPWA
       SWPB R0
       MOVB R0,@VDPWA
       LI   R1,>2000             * Space
       LI   R2,24*32
CLRLP  MOVB R1,@VDPWD
       DEC  R2
       JNE  CLRLP

* Write the greeting at row 10, column 11
       LI   R0,10*32+11
       ORI  R0,>4000
       SWPB R0
       MOVB R0,@VDPWA
       SWPB R0
       MOVB R0,@VDPWA
       LI   R1,MSG
       LI   R2,MSGL
MSGLP  MOVB *R1+,@VDPWD
       DEC  R2
       JNE  MSGLP

* Spin forever
HALT   JMP  HALT

*----------------------------------------------------------------------
* Data
*----------------------------------------------------------------------
REGLD  BYTE >00                  * R0: graphics I, no external video
       BYTE >E0                  * R1: 16K, display on, interrupts on
       BYTE >00                  * R2: screen image table at >0000
       BYTE >0E                  * R3: colour table at >0380
       BYTE >01                  * R4: pattern table at >0800
       BYTE >06                  * R5: sprite attributes at >0300
       BYTE >00                  * R6: sprite patterns at >0000
       BYTE >07                  * R7: white on cyan
       EVEN

MSG    TEXT 'HELLO TI-99/4A'
MSGL   EQU  $-MSG
       EVEN

       END  MAIN
