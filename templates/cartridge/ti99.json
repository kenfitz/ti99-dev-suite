{
  "version": 1,
  "name": "my-cartridge",
  "type": "cartridge-rpk",

  "syntaxDialect": "xdt99",
  "toolchainProfile": "xdt99",
  "processor": "9900",
  "registerSymbols": true,

  "entrySource": "src/main.a99",
  "sources": ["src/main.a99"],
  "includePaths": ["src", "lib"],
  "defines": {},

  "outputs": ["cart-rpk", "cart-bin"],
  "buildDir": "build",
  "distDir": "dist",

  "cartridge": {
    "name": "MY CARTRIDGE",
    "baseAddress": ">6000",
    "banking": "none",
    "binFilename": "MYCARTC.BIN"
  },

  "emulatorProfile": "mame-cart",

  "assembler": {
    "unresolvedReferencePolicy": "warning",
    "extraArgs": []
  }
}
