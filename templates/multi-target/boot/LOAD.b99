100 CALL CLEAR
110 CALL SCREEN(2)
120 CALL MAGNIFY(2)
130 PRINT "      {{MENUNAME}}"
140 PRINT
150 PRINT "  LOADING FROM DISK ..."
160 PRINT
170 PRINT "  THIS TAKES A MOMENT."
180 PRINT
190 PRINT "  THE MARKERS KEEP MOVING"
200 PRINT "  WHILE THE DISK IS READ."
210 PRINT "  IF THEY STOP, LOADING"
220 PRINT "  HAS FAILED."
230 CALL SPRITE(#1,42,13,150,80,0,18)
240 CALL SPRITE(#2,42,11,150,56,0,18)
250 CALL SPRITE(#3,42,11,150,32,0,18)
260 CALL SPRITE(#4,42,11,150,8,0,18)
270 CALL INIT
280 PRINT
290 PRINT "  READING PROGRAM ..."
300 CALL LOAD("DSK1.{{XBNAME}}")
310 PRINT "  STARTING ..."
320 CALL LINK("XBBOOT")
330 END
