100 CALL CLEAR
110 CALL SCREEN(2)
120 FOR S=1 TO 14 :: CALL COLOR(S,16,1):: NEXT S
130 PRINT "        {{MENUNAME}}"
140 PRINT
150 PRINT "     LOADING {{MENUNAME}} ..."
160 PRINT
170 PRINT "     READING DSK1.{{XBNAME}}"
180 PRINT
190 PRINT "     THIS TAKES A MOMENT."
200 PRINT
210 PRINT "     WHILE THE RING TURNS,"
220 PRINT "     THE DISK IS BEING READ."
230 PRINT
240 PRINT "     IF IT STOPS, LOADING"
250 PRINT "     HAS FAILED."
260 CALL CHAR(128,"3C7EFFFFFFFF7E3C")
270 CALL MAGNIFY(2)
280 CALL SPRITE(#1,128,13,150,128,0,6)
290 CALL SPRITE(#2,128,13,150,128,0,-6)
300 CALL SPRITE(#3,128,11,142,128,0,13)
310 CALL SPRITE(#4,128,11,142,128,0,-13)
320 CALL SPRITE(#5,128,7,158,128,0,21)
330 CALL SPRITE(#6,128,7,158,128,0,-21)
340 CALL INIT
350 CALL LOAD("DSK1.{{XBNAME}}")
360 CALL DELSPRITE(ALL)
370 CALL LINK("XBBOOT")
380 END
